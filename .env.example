# Copy to .env.local.
# Base URL of the checkout API (the Java backend), e.g. https://api.sortboxs.com/checkout — the drawer calls
# /order, /verify and /invoice-request under it. Contract: docs/checkout-api.md.
# Razorpay keys are NOT set here: the Next.js app is frontend-only (static export); keys live in the backend.
NEXT_PUBLIC_CHECKOUT_API_URL=

# TEMPORARY demo until the backend exists: a Razorpay TEST key id (rzp_test_…) lets the drawer open Razorpay
# from the browser (unverified, test mode only). Ignored once NEXT_PUBLIC_CHECKOUT_API_URL is set.
NEXT_PUBLIC_RAZORPAY_TEST_KEY_ID=

# SortBoxs backend base URL (subscription plans + checkout). Set per environment in .env.development /
# .env.production; override locally here if needed.
NEXT_PUBLIC_API_BASE_URL=
# Plan IDs to show on /pricing, comma-separated, in display order. Enterprise is a fixed card, not listed.
NEXT_PUBLIC_PLAN_IDS=

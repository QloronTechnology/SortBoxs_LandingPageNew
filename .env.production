# Public values for `next build` (committed — no secrets here).
# TEMPORARY: the production SortBoxs API URL isn't documented yet, so builds use the DEV API (its Razorpay
# key is test mode — no real payments). Replace both values when the backend team gives production ones.
NEXT_PUBLIC_API_BASE_URL=https://devapi.sortboxs.com
# Plan IDs, comma-separated, in display order (dev plan 170 until production IDs exist).
NEXT_PUBLIC_PLAN_IDS=170
# TEMPORARY (user's request, so /pricing looks complete): also show the showcase Starter / Professional /
# Business plans from src/data/mockPlans.ts. They can't be bought online (Pay asks people to contact
# sales). Set to false — or delete this line — once real plans are created in the SortBoxs admin.
NEXT_PUBLIC_MOCK_PLANS=true

# Public values for `next build` (committed — no secrets here).
# TEMPORARY: the production SortBoxs API URL isn't documented yet, so builds use the DEV API (its Razorpay
# key is test mode — no real payments). Replace both values when the backend team gives production ones.
NEXT_PUBLIC_API_BASE_URL=https://devapi.sortboxs.com
# /pricing lists every plan from GET /api/admin/subscriptions/cards (no plan IDs to configure).
# Showcase plans from src/data/mockPlans.ts: off now that real plans exist in the SortBoxs admin.
NEXT_PUBLIC_MOCK_PLANS=false
# Book a Demo API paths (relative to NEXT_PUBLIC_API_BASE_URL) — set when the backend publishes them.
# Until then the modal says online booking isn't connected yet (no simulated slots in production).
NEXT_PUBLIC_DEMO_AVAILABILITY_PATH=
NEXT_PUBLIC_DEMO_BOOKING_PATH=

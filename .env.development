# Public values for `next dev` (committed — no secrets here; secrets never go in NEXT_PUBLIC_ vars).
# SortBoxs backend (subscription plans + checkout).
NEXT_PUBLIC_API_BASE_URL=https://devapi.sortboxs.com
# Subscription plans shown on /pricing, comma-separated, in display order (until the backend has a
# "list plans" endpoint).
NEXT_PUBLIC_PLAN_IDS=170
# Preview only: also show the mock Starter / Professional / Business plans (src/data/mockPlans.ts) to see
# the layout with more plans than fit in a row. Set to false (or remove) to see only real backend plans.
NEXT_PUBLIC_MOCK_PLANS=true
# Book a Demo API paths (relative to NEXT_PUBLIC_API_BASE_URL). Not published by the backend yet — leave
# empty until they are. Contract the modal expects: src/lib/api/demoBookingMappers.ts.
NEXT_PUBLIC_DEMO_AVAILABILITY_PATH=
NEXT_PUBLIC_DEMO_BOOKING_PATH=
# TEMPORARY, dev only: simulate availability + submit (src/lib/api/demoBookingPreview.ts) while the paths
# above are empty. Nothing is sent (no badge in the UI, so keep this false for any shared/prod build).
NEXT_PUBLIC_DEMO_BOOKING_PREVIEW=true
